# ═══════════════════════════════════════════════════════════════════════════
# SPEC §5.11 — environment variables
# Phase 0 needs only NEXT_PUBLIC_SITE_URL. The rest are listed so the file is
# complete, and are commented out until the phase that introduces them.
# ═══════════════════════════════════════════════════════════════════════════

# Phase 0 — required. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1 — Sanity
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=development
# NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# SANITY_API_READ_TOKEN=
# SANITY_API_WRITE_TOKEN=
# SANITY_WEBHOOK_SECRET=
# SANITY_PREVIEW_SECRET=

# Phase 5 — Postgres, email, spam, rate limiting
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# EMAIL_FROM="[Your Name] <hello@yourdomain.com>"
# EMAIL_TO_CONTACT=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# IP_HASH_SALT=

# Phase 7 — analytics, monitoring, cron
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# CRON_SECRET=
# NEXT_PUBLIC_ENABLE_VIEW_COUNTS=false
