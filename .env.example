# ═══════════════════════════════════════════════════════════════════════════
# SPEC §5.11 — environment variables
# Phase 0 needs only NEXT_PUBLIC_SITE_URL. The rest are listed so the file is
# complete, and are commented out until the phase that introduces them.
# ═══════════════════════════════════════════════════════════════════════════

# Phase 0 — required. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1 — Sanity. Create a project at https://sanity.io/manage, then fill
# these in. The id is on the project's dashboard; tokens under API → Tokens.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Viewer role — used by draft preview (Phase 2). Server-only.
SANITY_API_READ_TOKEN=
# Editor role — used ONLY by `npm run seed`. Server-only, never deployed.
SANITY_API_WRITE_TOKEN=
# SANITY_WEBHOOK_SECRET=   (Phase 7)
# Note: no SANITY_PREVIEW_SECRET — preview auth uses short-lived dataset
# secrets (@sanity/preview-url-secret) verified with SANITY_API_READ_TOKEN.

# Phase 5 — Postgres, email, spam, rate limiting. Every service degrades
# gracefully when unset (limits open, emails logged to console, forms report
# they're not wired up) — see docs/PHASE-5-NOTES.md for the setup order.
# Neon (https://neon.tech): the pooled connection string.
DATABASE_URL=
# Resend (https://resend.com): API key + the audience confirmed subscribers join.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="[Your Name] <hello@yourdomain.com>"
# Where contact-form notifications go (your personal inbox).
EMAIL_TO_CONTACT=
# Upstash Redis (https://upstash.com): rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile (https://dash.cloudflare.com): spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Any long random string; used to hash IPs (raw IPs are never stored).
IP_HASH_SALT=

# Phase 7 — analytics, monitoring, cron
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# CRON_SECRET=
# NEXT_PUBLIC_ENABLE_VIEW_COUNTS=false
