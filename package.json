{
  "name": "writer-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint src tests --fix",
    "typegen": "node scripts/typegen.mjs",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typegen && npm run typecheck && npm run lint && npm run test && npm run build",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "lint:content": "tsx --env-file-if-exists=.env.local scripts/content-lint.ts",
    "reindex": "tsx --env-file-if-exists=.env.local scripts/reindex-search.ts",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-email/components": "^1.0.12",
    "@sanity/client": "^7.25.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^4.22.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.4",
    "next-sanity": "^11.6.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "sanity": "^4.22.0",
    "shiki": "^4.3.1",
    "styled-components": "^6.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.4",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,css,md,json}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
