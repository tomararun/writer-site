{
  "name": "writer-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint src tests --fix",
    "typegen": "node scripts/typegen.mjs",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "verify": "npm run typegen && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@sanity/client": "^7.25.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^4.22.0",
    "next": "15.5.4",
    "next-sanity": "^11.6.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^4.22.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.4",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,css,md,json}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
